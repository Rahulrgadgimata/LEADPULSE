# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/leadpulse
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadpulse
DB_USER=postgres
DB_PASSWORD=password

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Groq API — Primary Fast AI Engine for Score Explanations (Free & Ultra Fast)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Claude API (Anthropic) — Alternative AI Engine
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Apollo.io — for contact & company enrichment (Optional)
APOLLO_API_KEY=your-apollo-api-key

# Hunter.io — for email verification & domain search (Optional)
HUNTER_API_KEY=your-hunter-api-key

# Web Scraping Configuration
SCRAPE_RATE_LIMIT_MS=2000
SCRAPE_MAX_CONCURRENT=3
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Scheduled Lead Discovery (Cron expression — default: daily at 6 AM)
DISCOVERY_CRON=0 6 * * *
