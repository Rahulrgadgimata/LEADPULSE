# LeadPulse AI — copy to .env and fill in values (never commit .env)

PORT=3000
TRUST_PROXY=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite — on Railway use /data/database.sqlite (volume mounted)
SQLITE_PATH=./backend/database.sqlite

# Groq (lead extraction + copilot)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_CHAT_API_KEY=
GROQ_MODEL_EXTRACTION=openai/gpt-oss-120b
GROQ_MODEL_CHAT=qwen/qwen3.6-27b

# Mistral fallback
MISTRAL_API_KEY=
MISTRAL_MODEL_EXTRACTION=mistral-small-latest
MISTRAL_MODEL_CHAT=mistral-small-latest

# Enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# Scrapling sidecar (same container on Railway)
SCRAPLING_ENABLED=true
SCRAPLING_HOST=127.0.0.1
SCRAPLING_PORT=3765
SCRAPLING_DEFAULT_MODE=fetcher
SCRAPLING_PYTHON=python3

# Discovery tuning — set low for fast runs (~10 leads), raise for deeper scans
# At 10 leads: ~3-7 min per run. At 150 leads: ~20-45 min per run.
DISCOVERY_TARGET_LEADS=10
DISCOVERY_MAX_QUERIES=6
DISCOVERY_STALE_JOB_MINUTES=10
SCRAPER_CONCURRENCY=4
SCRAPER_PAGE_TIMEOUT_MS=6000
ENRICHMENT_CONCURRENCY=4

# LinkedIn & buyer volume (keep proportional to DISCOVERY_TARGET_LEADS)
LINKEDIN_TARGET_LEADS=5
LINKEDIN_MAX_QUERIES=4
BUYER_TARGET_LEADS=5
BUYER_MAX_QUERIES=3

# Directory mining — "Top N companies in <city>" pages
DISCOVERY_DIRECTORY_PAGES=2
DISCOVERY_DIRECTORY_LINKS=10

# Search sources
SEARCH_ENABLE_GOOGLE=false
SEARCH_SOURCE_COOLDOWN_AFTER=3
SEARCH_SOURCE_COOLDOWN_MS=240000
SCRAPER_DELAY_MS=2000

# Optional: add a real search API key for faster, block-free discovery
# Serper — https://serper.dev  (free tier ~2,500 queries)
SERPER_API_KEY=
# Brave  — https://brave.com/search/api  (free tier ~2,000/month)
BRAVE_API_KEY=
