# LeadPulse AI — copy to .env and fill in values (never commit .env)

PORT=3000
TRUST_PROXY=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite — on Render use /var/data/database.sqlite (the disk mount path; on the
# free instance type there is no disk, so that file is wiped on every restart)
SQLITE_PATH=./backend/database.sqlite

# Groq (lead extraction + copilot)
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_CHAT_API_KEY=
GROQ_MODEL_EXTRACTION=openai/gpt-oss-120b
GROQ_MODEL_CHAT=qwen/qwen3.6-27b

# Mistral fallback
MISTRAL_API_KEY=
MISTRAL_MODEL_EXTRACTION=mistral-small-latest
MISTRAL_MODEL_CHAT=mistral-small-latest

# Enrichment
APOLLO_API_KEY=
HUNTER_API_KEY=
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# Scrapling sidecar (same container on Render)
SCRAPLING_ENABLED=true
SCRAPLING_HOST=127.0.0.1
SCRAPLING_PORT=3765
SCRAPLING_DEFAULT_MODE=fetcher
SCRAPLING_PYTHON=python3

# Discovery tuning — set low for fast runs (~10 leads), raise for deeper scans
# At 10 leads: ~3-7 min per run. At 150 leads: ~20-45 min per run.
DISCOVERY_TARGET_LEADS=10
DISCOVERY_MAX_QUERIES=6
DISCOVERY_STALE_JOB_MINUTES=10
SCRAPER_CONCURRENCY=4
SCRAPER_PAGE_TIMEOUT_MS=6000
ENRICHMENT_CONCURRENCY=4

# LinkedIn & buyer volume (keep proportional to DISCOVERY_TARGET_LEADS)
LINKEDIN_TARGET_LEADS=5
LINKEDIN_MAX_QUERIES=4
BUYER_TARGET_LEADS=5
BUYER_MAX_QUERIES=3

# Directory mining — "Top N companies in <city>" pages
DISCOVERY_DIRECTORY_PAGES=2
DISCOVERY_DIRECTORY_LINKS=10

# Search sources
SEARCH_ENABLE_GOOGLE=false
SEARCH_SOURCE_COOLDOWN_AFTER=3
SEARCH_SOURCE_COOLDOWN_MS=240000
SCRAPER_DELAY_MS=2000

# Optional: add a real search API key for faster, block-free discovery
# Serper — https://serper.dev  (free tier ~2,500 queries)
SERPER_API_KEY=
# Brave  — https://brave.com/search/api  (free tier ~2,000/month)
BRAVE_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Phase 2 — AI Outreach & Message Engine
# ═══════════════════════════════════════════════════════════════════

# Which engine writes the first draft.
#   auto     — first configured of: Gemini → Claude → Groq → template
#   gemini   — Google Generative Language API (needs GEMINI_API_KEY)
#   claude   — Anthropic Messages API (needs ANTHROPIC_API_KEY)
#   groq     — reuses GROQ_CHAT_API_KEY / GROQ_API_KEY above
#   template — deterministic, no API call, no key
# Whichever you pick, the keyless "Open in Gemini" handoff button is always
# available in the UI: it builds the prompt, you paste it into Gemini signed in
# as yourself, then paste the reply back. No server can borrow a browser login,
# so that flow needs a human in the middle by design.
OUTREACH_AI_PROVIDER=auto

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — the Claude-drafted path from the Phase 2 spec.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Who the email is from, and why you are writing. OUTREACH_VALUE_PROP is the
# single biggest lever on draft quality — without it the model has to guess.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=
OUTREACH_SENDER_COMPANY=
OUTREACH_VALUE_PROP=

# ─── SMTP delivery ─────────────────────────────────────────────────
# SendGrid:  host=smtp.sendgrid.net  port=587  user=apikey  pass=<API key>
# Gmail:     host=smtp.gmail.com     port=587  user=<you@gmail.com>
#            pass=<16-char App Password, NOT your account password —
#            https://myaccount.google.com/apppasswords>
# Never commit the real values; they belong in .env only.
SMTP_HOST=
SMTP_PORT=587
# Leave unset to derive from the port (465 = implicit TLS, 587 = STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LeadPulse AI
MAIL_REPLY_TO=

# true = record sends in the log but open no SMTP connection. Leave this on
# until you have read a few real drafts end to end.
OUTREACH_DRY_RUN=true

# Blast-radius caps. A bad cold email cannot be recalled.
OUTREACH_DAILY_SEND_LIMIT=200
OUTREACH_BULK_SEND_LIMIT=50

# Scheduled-send poller
OUTREACH_SCHEDULER_ENABLED=true
OUTREACH_SCHEDULER_INTERVAL_MS=30000

# Public origin for unsubscribe links. Must be reachable by the recipient —
# a localhost URL produces a link only you can open.
APP_BASE_URL=
